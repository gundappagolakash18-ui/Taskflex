# ============================================================
# TASKFLEX — PRODUCTION deployment configuration
#
# Copy this file to .env (same folder as docker-compose.prod.yml)
# and fill in every REQUIRED value before starting the stack:
#
#   cp .env.prod.example .env
#
# The real .env must never be committed or shared.
# ============================================================

# ---- Public address of your site (REQUIRED) ----
# The URL users type in the browser, no trailing slash.
# It must also appear in CORS_ORIGINS.
FRONTEND_ORIGIN=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
# Host port the site is served on (80 behind a TLS proxy, or 8080 etc.)
HTTP_PORT=80

# ---- Database (internal to the Docker stack) ----
# These credentials stay inside the Docker network; pick a strong password.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=taskflex
POSTGRES_PASSWORD=
POSTGRES_DB=taskflex
# NOTE: do NOT set DATABASE_URL here — docker-compose.prod.yml wires the
# backend to the db service automatically.

# ---- Security (REQUIRED) ----
# Two DIFFERENT long random strings. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start in production with development secrets.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- Google sign-in (recommended) ----
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
# See docs/google-oauth-setup.md. Leave empty to hide the Google buttons.
GOOGLE_CLIENT_ID=

# ---- Email via Gmail SMTP (REQUIRED — signups need real OTP emails) ----
# 1. Turn on 2-Step Verification for the Google account you'll send from
# 2. Create an App Password (16 characters): https://myaccount.google.com/apppasswords
# 3. SMTP_USER = that Gmail address, SMTP_PASSWORD = the 16-char app password
# The backend refuses to start in production without these.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# One-time passcode rules
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Pepper for the HMAC digest behind the start/completion task handshake codes.
# REQUIRED in production: a long random string, different from the JWT secrets.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OTP_PEPPER=
OTP_LOCK_MINUTES=15

# ---- AI provider (mock = built-in parser, no key needed) ----
# Set to "openai" or "anthropic" + API key for real natural-language parsing.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Maps / geocoding ----
# "osm" needs no API key (rate-limited by OpenStreetMap).
MAPS_PROVIDER=osm
MAPS_API_KEY=

# ---- Payments (REQUIRED for real money — see docs/razorpay-setup.md) ----
# "razorpay" = live hosted checkout (recommended for production).
# "mock" simulates payments — only use it while testing, never with real users.
# With PAYMENT_PROVIDER=razorpay the backend refuses to start if the keys below
# are missing, so payments are never silently simulated in production.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set when creating the webhook in the Razorpay dashboard
# (Settings → Webhooks → URL https://yourdomain.com/api/v1/payments/webhook/razorpay).
RAZORPAY_WEBHOOK_SECRET=

# ---- Platform business rules ----
PLATFORM_COMMISSION_PERCENT=10.0
DEFAULT_WORKER_RADIUS_KM=8.0
OFFER_TTL_MINUTES=15
MAX_OFFERS_PER_TASK=6

# ---- File uploads ----
MAX_UPLOAD_SIZE_MB=10
