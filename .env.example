# ============================================================
# TASKFLEX environment configuration (copy to .env and edit)
# Never commit real secrets.
# ============================================================

# ---- Application ----
APP_NAME=TASKFLEX
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# ---- Database ----
# PostgreSQL (production / docker compose):
DATABASE_URL=postgresql+psycopg2://taskflex:taskflex@localhost:5432/taskflex
# SQLite (quick local run / tests):
# DATABASE_URL=sqlite:///./taskflex.db

# ---- Security ----
JWT_SECRET=change-me-access-secret-please-generate-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-please-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---- AI provider (openai | anthropic | mock) ----
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- Maps / geocoding (osm needs no key; empty = mock fallback) ----
MAPS_PROVIDER=osm
MAPS_API_KEY=

# ---- Payments (mock | razorpay) ----
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Platform business rules ----
PLATFORM_COMMISSION_PERCENT=10.0
DEFAULT_WORKER_RADIUS_KM=8.0
OFFER_TTL_MINUTES=15
MAX_OFFERS_PER_TASK=6

# ---- Notifications ----
EMAIL_PROVIDER=smtp
SMS_PROVIDER=log

# ---- Email via Gmail SMTP (REQUIRED for real signups) ----
# Create a Google App Password: myaccount.google.com/apppasswords (2-Step Verification must be on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=your16charapppassword
EMAIL_FROM=

# ---- One-time passcodes (email verification) ----
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- File uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ---- Startup / bootstrap ----
SEED_ON_START=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
